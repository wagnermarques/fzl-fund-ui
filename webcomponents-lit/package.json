    },
    "./button": {
      "types": "./dist/button.d.ts",
      "import": "./dist/button.js"
    },
    "./crumb": {
      "types": "./dist/crumb.d.ts",
      "import": "./dist/crumb.js"
    },
    "./card-list": {
      "types": "./dist/card-list.d.ts",
      "import": "./dist/card-list.js"
    },
    "./reader-chapterview": {
      "types": "./dist/reader-chapterview.d.ts",
      "import": "./dist/reader-chapterview.js"
    },
    "./avatar-upload": {
      "types": "./dist/avatar-upload.d.ts",
      "import": "./dist/avatar-upload.js"
    },
    "./chip": {
      "types": "./dist/reader-chapterview.d.ts",
      "import": "./dist/reader-chapterview.js"
    },
    "./availability-grid": {
      "types": "./dist/availability-grid.d.ts",
      "import": "./dist/availability-grid.js"
    },
    "./geo-map": {
      "types": "./dist/geo-map.d.ts",
      "import": "./dist/geo-map.js"
    },
    "./geo-explorer": {
      "types": "./dist/geo-explorer.d.ts",
      "import": "./dist/geo-explorer.js"
    },
    "./form": {
      "types": "./dist/form.d.ts",
      "import": "./dist/form.js"
    },
    "./data-grid": {
      "types": "./dist/data-grid.d.ts",
      "import": "./dist/data-grid.js"
    },
    "./reader-mark-bar": {
      "types": "./dist/reader-mark-bar.d.ts",
      "import": "./dist/reader-mark-bar.js"
    },
    "./reader-content": {
      "types": "./dist/reader-content.d.ts",
      "import": "./dist/reader-content.js"
    },
    "./custom-elements.json": "./custom-elements.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "analyze": "cem analyze --litelement",
    "typecheck": "tsc --noEmit"
  },
  "customElements": "custom-elements.json",
  "files": [
    "dist",
    "custom-elements.json"
  ],
  "peerDependencies": {
    "lit": "^3.2.1"
  },
  "devDependencies": {
    "@fzl/core": "*",
    "@fzl/design-tokens": "*",
    "@types/leaflet": "^1.9.22",
    "lit": "^3.3.3",
    "vite": "^8.0.0",
    "vite-plugin-dts": "^4.3.0"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  }
}
