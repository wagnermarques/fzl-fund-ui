{
  "name": "@fzl/webcomponents-lit",
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "./dist/fzl-lit.js",
  "module": "./dist/fzl-lit.js",
  "types": "./dist/fzl-lit.d.ts",
  "exports": {
    ".": {
      "types": "./dist/fzl-lit.d.ts",
      "import": "./dist/fzl-lit.js"
    },
    "./button": {
      "types": "./dist/button.d.ts",
      "import": "./dist/button.js"
    },
    "./crumb": {
      "types": "./dist/crumb.d.ts",
      "import": "./dist/crumb.js"
    },
    "./card-list": {
      "types": "./dist/card-list.d.ts",
      "import": "./dist/card-list.js"
    },
    "./custom-elements.json": "./custom-elements.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "analyze": "cem analyze --litelement",
    "typecheck": "tsc --noEmit"
  },
  "customElements": "custom-elements.json",
  "files": [
    "dist",
    "custom-elements.json"
  ],
  "peerDependencies": {
    "lit": "^3.2.1"
  },
  "devDependencies": {
    "@fzl/design-tokens": "*",
    "lit": "^3.3.3"
